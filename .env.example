# ── Shared App Config ──
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Onboarding API Backend Endpoint ──
NEXT_PUBLIC_ONBOARDING_API_URL=https://upswing-bonsai-supermom.ngrok-free.dev/api/v1/onboarding

# ── Auth & JWT ──
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── AI Service (Google Gemini API Key) ──
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_MODEL=gemini-3.1-flash-lite

# ── SMS OTP Service (Gupshup) ──
GUPSHUP_API_KEY=your_gupshup_api_key_here
GUPSHUP_APP_NAME=SpiritualSakha
GUPSHUP_SENDER_ID=SAKHA

# ── Database & Cache ──
DATABASE_URL=postgresql://sakha:password@localhost:5432/spiritualsakha
REDIS_URL=redis://localhost:6379

# ── Google Cloud Voice (Speech-to-Text & Text-to-Speech) ──
GOOGLE_CLOUD_PROJECT_ID=spiritual-sakha-prod
GOOGLE_APPLICATION_CREDENTIALS=./config/google-service-account.json
